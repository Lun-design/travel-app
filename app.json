{
  "expo": {
    "name": "大白小白出遊去",
    "slug": "travel-planner",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./icon.png",
    "scheme": "travel-planner",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./icon.png"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F8F6F0",
        "foregroundImage": "./icon.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./favicon.png",
      "name": "大白小白出遊去",
      "shortName": "大白出遊",
      "startUrl": "/",
      "scope": "/",
      "display": "standalone",
      "backgroundColor": "#F8F6F0",
      "themeColor": "#9A6A45",
      "lang": "zh-Hant"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F8F6F0",
          "android": {
            "image": "./assets/images/splash-icon.png",
            "imageWidth": 76
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
